# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sagasia_crm
DB_USERNAME=root
DB_PASSWORD=root

# Security
APP_SECURITY_TOKEN_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars-long
APP_SECURITY_TOKEN_EXPIRATION_MINUTES=120

# Admin Seed
APP_SECURITY_SEED_ADMIN_EMAIL=admin@sagasia.com
APP_SECURITY_SEED_ADMIN_PASSWORD=Admin@123

# CORS
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Server
SERVER_PORT=8080

